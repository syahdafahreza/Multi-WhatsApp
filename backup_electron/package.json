{
  "name": "multi-whatsapp",
  "version": "1.1.0",
  "description": "Multi tab WhatsApp desktop client",
  "main": "main.js",
  "scripts": {
    "prepare:dist": "node scripts/prepare-dist.js",
    "start": "tauri dev",
    "tauri": "tauri",
    "build": "tauri build",
    "start:electron": "electron .",
    "build:electron": "electron-builder",
    "make:electron": "electron-builder"
  },
  "keywords": [],
  "author": "Syahda Fahreza",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.umarkov.multiwhatsapp",
    "productName": "Multi-WhatsApp",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
