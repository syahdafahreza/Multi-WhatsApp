{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-WhatsApp",
  "version": "1.1.0",
  "identifier": "com.umarkov.multiwhatsapp",
  "build": {
    "beforeBuildCommand": "node ../scripts/prepare-dist.js",
    "beforeDevCommand": "node ../scripts/prepare-dist.js",
    "frontendDist": "../dist_app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multi-WhatsApp",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
